# Copy this file to `.env` and fill in your values. `.env` is gitignored and
# loaded automatically at startup (python-dotenv). Every variable is optional
# except ANTHROPIC_API_KEY, which is required to serve live queries.

# --- Anthropic ------------------------------------------------------------- #
# Required to serve /query. Read directly by the Anthropic SDK.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Model identifier. Defaults to claude-sonnet-4-5-20250929 if unset.
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Optional: override the API base URL (e.g. a proxy). The SDK reads this itself.
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# --- Pipeline tunables ----------------------------------------------------- #
# Per-stage max output tokens.
ROUTER_MAX_TOKENS=512
SPECIALIST_MAX_TOKENS=1024
SYNTHESIZER_MAX_TOKENS=2048

# Default top_k for a specialist's search tool.
DOCUMENTS_PER_QUERY=3

# Max concurrent specialist threads.
MAX_WORKER_THREADS=4

# Model<->tool round-trips per specialist before a final answer is forced.
MAX_TOOL_ITERATIONS=4

# Conversation messages retained per session (user + assistant turns).
MAX_HISTORY_MESSAGES=6

# Maximum accepted length (characters) of a sanitized query.
MAX_QUERY_LENGTH=10000

# --- HTTP server (used by `python wsgi.py` and `flask run`) ---------------- #
FLASK_RUN_HOST=127.0.0.1
FLASK_RUN_PORT=8000
FLASK_DEBUG=0
